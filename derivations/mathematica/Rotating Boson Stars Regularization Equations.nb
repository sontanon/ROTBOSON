Cell[TextData[{
 "We will calculate now ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["D", "j"], 
     SuperscriptBox["K", 
      RowBox[{"i", " ", "j"}]]}], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "j"], 
       SuperscriptBox["K", 
        RowBox[{"i", " ", "j"}]]}], "+", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["\[CapitalGamma]", "i"], 
        RowBox[{"j", " ", "k"}]], 
       SuperscriptBox["K", 
        RowBox[{"k", " ", "j"}]]}], "+", 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["\[CapitalGamma]", "j"], 
        RowBox[{"j", " ", "k"}]], 
       SuperscriptBox["K", 
        RowBox[{"i", " ", "k"}]]}]}], "=", 
     RowBox[{"8", "\[Pi]", " ", 
      SuperscriptBox["j", "i"]}]}]}], TraditionalForm]],ExpressionUUID->
  "f4036c4b-131e-42b6-9163-c4bd9a9019f6"],
 " for ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "a8ff8ba9-5bc2-4b25-bac2-bbe4df035939"],
 "=\[CurlyPhi]."
}], "Text",
