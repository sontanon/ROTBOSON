Cell[TextData[{
 "Notice that we have second derivatives in both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ",", " ", "H"}], TraditionalForm]],ExpressionUUID->
  "b132954c-477a-408f-9c06-5b67b14f3a4b"],
 ". We will need an additional equation to decouple them."
}], "Text",
 CellChangeTimes->{{3.7724673451363583`*^9, 3.772467383519554*^9}, {
  3.7814749943797455`*^9, 
  3.781474996499482*^9}},ExpressionUUID->"0fddbc1f-4f59-4f38-916b-\
1afc6c79150c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stationary State.", "Subsubsection",
 CellChangeTimes->{{3.769990855282192*^9, 
  3.7699908663456907`*^9}},ExpressionUUID->"d008e92a-a422-4b0f-85ff-\
51e27d0b89ed"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "t"], 
    SubscriptBox["K", 
     RowBox[{"i", " ", "j"}]]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sterling]", "\[Beta]"], 
      SubscriptBox["K", 
       RowBox[{"i", " ", "j"}]]}], "-", 
     RowBox[{
      SubscriptBox["D", "i"], 
      SubscriptBox["D", "j"], "\[Alpha]"}], "+", 
     RowBox[{"\[Alpha]", "(", 
      RowBox[{
       SubscriptBox["R", 
        RowBox[{"i", " ", "j"}]], "+", 
       RowBox[{"K", " ", 
        SubscriptBox["K", 
         RowBox[{"i", " ", "j"}]]}], "-", 
       RowBox[{"2", 
        SubscriptBox["K", 
         RowBox[{"i", " ", "k"}]], 
        SubscriptBox[
         SuperscriptBox["K", "k"], "j"]}], "+", 
       RowBox[{"4", 
        RowBox[{"\[Pi]", "(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"S", "-", "u"}], ")"}], 
           SubscriptBox["\[Gamma]", 
            RowBox[{"i", " ", "j"}]]}], "-", 
          RowBox[{"2", 
           SubscriptBox["S", 
            RowBox[{"i", " ", "j"}]]}]}], ")"}]}]}], ")"}]}], " ", "=", " ", 
    "0."}]}], 
  TraditionalForm]],ExpressionUUID->"d423ad70-30c6-45dc-a43f-6012997433bd"]], \
"Text",
 CellChangeTimes->{{3.7699908823926077`*^9, 3.7699909037278533`*^9}, {
  3.7699909552910056`*^9, 3.769991070632962*^9}, {3.770723012733317*^9, 
  3.770723013292823*^9}, {3.7723897002113314`*^9, 
  3.7723897150486326`*^9}},ExpressionUUID->"4fbcb947-37dc-4b31-b3df-\
c062e3990953"],

Cell[TextData[{
 "The equation we are looking for comes from considering the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"j", " ", "=", "\[CurlyPhi]"}]}], TraditionalForm]],
  ExpressionUUID->"676c2991-f279-4fe1-abc2-a68954f992ea"],
 " component. Remember that as before, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "=", 
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"=", 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[CurlyPhi]"], 
       RowBox[{"=", "0"}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "21441d5b-39fb-4ec7-93ec-5a043fcc0f88"],
 ". The Lie derivative also vanishes identically for this component. Also, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
