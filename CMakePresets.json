{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (debug, warnings, ASan/UBSan)",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "displayName": "Release (O3)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "umfpack",
      "displayName": "Release, MKL-free (SuiteSparse/UMFPACK)",
      "binaryDir": "${sourceDir}/build/umfpack",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ROTBOSON_SOLVER_BACKEND": "umfpack"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Release + ASan/UBSan",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "umfpack", "configurePreset": "umfpack" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" }
  ]
}
