Cell[TextData[{
 "Full space-time metric ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
    RowBox[{
     TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          SubscriptBox["\[Gamma]", 
           RowBox[{"i", " ", "j"}]], 
          SubscriptBox["\[Beta]", "i"]},
         {
          SubscriptBox["\[Beta]", "i"], 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[Alpha]", "2"]}], "+", 
           RowBox[{
            SuperscriptBox["\[Beta]", "k"], 
            SubscriptBox["\[Beta]", "k"]}]}]}
        },
        GridBoxAlignment->{
         "Columns" -> {{Center}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
