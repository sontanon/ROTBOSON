Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"8", " ", "\[Pi]", " ", 
     SuperscriptBox["\[Rho]", 
      RowBox[{"2", " ", "l"}]], " ", 
     SuperscriptBox["\[Omega]", "2"], " ", 
     RowBox[{"A", "[", 
