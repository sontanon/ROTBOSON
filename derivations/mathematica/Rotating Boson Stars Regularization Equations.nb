Cell[TextData[{
 "It is obvious that the trace of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"i", " ", "j"}]], TraditionalForm]],ExpressionUUID->
  "8266871d-05de-4f6b-a0b0-5cc334950849"],
 " is zero. Next up ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["K", 
      RowBox[{"i", " ", "j"}]], 
     SuperscriptBox["K", 
      RowBox[{"i", " ", "j"}]]}], "=", 
    RowBox[{
     SubscriptBox["K", 
      RowBox[{"i", " ", "j"}]], 
     SubscriptBox["K", 
      RowBox[{"k", " ", "l"}]], 
     SuperscriptBox["\[Gamma]", 
      RowBox[{"i", " ", "k"}]], 
     RowBox[{
      SuperscriptBox["\[Gamma]", 
       RowBox[{"j", " ", "l"}]], "."}]}]}], TraditionalForm]],ExpressionUUID->
  "cb9b6a50-d30d-4d56-b146-6224bdfa880d"]
}], "Text",
