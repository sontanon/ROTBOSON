# Build artifacts
obj/*.o
ROTBOSON
ooc_*
out/*/*
out/*.log
*.egg-info/
build/
compile_commands.json

# Editor / IDE
.vscode/
VSC_Workspace
*.swp

# Python tooling (uv)
.venv/
__pycache__/
.ipynb_checkpoints/

# Archived publication data from the backup drive (see PLAN.md and
# data/golden/README.md): golden solutions, summary tables, and the
# old-pipeline parameter templates/convergence configs. Only data/paper/
# and small test fixtures are tracked; everything else is restored from
# the archive drive when needed (git history keeps the retired configs).
data/golden/
data/seeds/
data/summaries/
data/params/
data/convergence/

# Re-derived symbolic notebooks are tracked under derivations/notebooks
# (stripped of outputs); raw notebook files are ignored everywhere else.
*.ipynb
!derivations/notebooks/*.ipynb

# Raw outputs and configs (legacy formats)
*.asc
*.cfg
*.json
!CMakePresets.json
# Round-trip test fixtures are deliberate, versioned state.json snapshots
!tests/fixtures/*.json
