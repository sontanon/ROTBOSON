Cell[CellGroupData[{

Cell["Extrinsic Curvature.", "Subsubsection",
 CellChangeTimes->{{3.7674026802179136`*^9, 3.767402690519498*^9}, 
   3.7674033645559597`*^9, 
   3.7699607820237083`*^9},ExpressionUUID->"37c12fba-54dc-4267-8ece-\
46d6c8e9ed7a"],

Cell[TextData[{
 "Calculate extrinsic curvature: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", 
     RowBox[{"i", " ", "j", " "}]], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Alpha]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         SubscriptBox["\[Gamma]", 
          RowBox[{"i", " ", "j"}]]}]}], "+", 
       RowBox[{
        SuperscriptBox["\[Beta]", "k"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "k"], 
         SubscriptBox["\[Gamma]", 
          RowBox[{"i", " ", "j"}]]}]}], "+", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         RowBox[{"k", " ", "j"}]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "i"], 
         SuperscriptBox["\[Beta]", "k"]}]}], "+", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         RowBox[{"i", " ", "k"}]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "j"], 
         SuperscriptBox["\[Beta]", "k"]}]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"01e702e2-087c-4d05-ba00-261fe836635d"],
 ". Notice that ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "f3462307-54d6-4b00-b2ae-939a4b8f1960"],
 " and ",
 Cell[BoxData[
  FormBox["\[CurlyPhi]", TraditionalForm]],ExpressionUUID->
  "40de706a-851a-4c27-8eff-b5d0c1727641"],
 " derivatives are zero: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", 
     RowBox[{"i", " ", "j"}]], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Alpha]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Gamma]", 
         RowBox[{"\[CurlyPhi]", " ", "i"}]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "j"], 
         SuperscriptBox["\[Beta]", "\[CurlyPhi]"]}]}], "+", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         RowBox[{"\[CurlyPhi]", " ", "j"}]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "i"], 
         SuperscriptBox["\[Beta]", "\[CurlyPhi]"]}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"df0b3c69-00cb-4095-a97e-1bb0a82642e7"]
}], "Text",
 CellChangeTimes->{{3.7674026980067754`*^9, 3.7674027142198925`*^9}, {
  3.76740310736151*^9, 3.7674031083709517`*^9}, {3.769960772798648*^9, 
  3.7699609408061085`*^9}, {3.7699612516160626`*^9, 3.7699612782715683`*^9}, {
  3.7723890742410655`*^9, 3.77238907710532*^9}, {3.775237251067007*^9, 
