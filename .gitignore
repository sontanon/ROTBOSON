# Build artifacts
build/
compile_commands.json
ROTBOSON
ooc_*
*.egg-info/

# Editor / IDE
.vscode/
*.swp

# Python tooling (uv)
.venv/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Run outputs: the runbook's step (a) cds into out/, so the directory keeps a
# tracked .gitkeep stub; everything the solver and the driver write there is
# local-only.
out/*
!out/.gitkeep

# Archived publication data from the backup drive (4.7 GB, not tracked):
# golden solutions, summary tables, and the old-pipeline parameter
# templates/convergence configs. Recoverable from the archive drive or git
# history; only data/paper/ and the test fixtures are tracked.
data/golden/
data/seeds/
data/summaries/
data/params/
data/convergence/

# Solution data and legacy formats — HDF5 is tracked only as the pinned
# roundtrip fixture; the only tracked notebook is the codegen notebook under
# derivations/.
*.h5
!tests/fixtures/*.h5
*.par
*.asc
*.cfg
*.json
!CMakePresets.json
!tests/fixtures/*.json
*.ipynb
!derivations/*.ipynb
