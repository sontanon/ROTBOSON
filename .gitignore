data/golden/
data/seeds/

# Re-derived symbolic notebooks are tracked under derivations/notebooks
# (stripped of outputs); raw notebook files are ignored everywhere else.
*.ipynb
!derivations/notebooks/*.ipynb

# Raw outputs and configs (legacy formats)
*.asc
*.cfg
*.json
