Cell[BoxData[
 RowBox[{
  RowBox[{"i3", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            SuperscriptBox["A", "2"]]}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
