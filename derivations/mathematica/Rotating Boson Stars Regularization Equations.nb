5329a8b8f6c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tMuNu", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"D", "[", 
             RowBox[{"\[CapitalPhi]", ",", 
              RowBox[{"coord", "[", 
               RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"D", "[", 
             RowBox[{"c\[CapitalPhi]", ",", 
              RowBox[{"coord", "[", 
               RowBox[{"[", "\[Nu]", "]"}], "]"}]}], "]"}], ")"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"D", "[", 
             RowBox[{"c\[CapitalPhi]", ",", 
              RowBox[{"coord", "[", 
               RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"D", "[", 
             RowBox[{"\[CapitalPhi]", ",", 
              RowBox[{"coord", "[", 
               RowBox[{"[", "\[Nu]", "]"}], "]"}]}], "]"}], ")"}]}]}], 
         ")"}]}], "-", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"g", "[", 
         RowBox[{"[", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ig", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], 
             RowBox[{"(", 
              RowBox[{"D", "[", 
               RowBox[{"c\[CapitalPhi]", ",", 
                RowBox[{"coord", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"D", "[", 
               RowBox[{"\[CapitalPhi]", ",", 
                RowBox[{"coord", "[", 
